{
  // Cloudflare Workers の設定ファイル。
  // API（Hono）とフロントエンド（apps/web をビルドした静的ファイル）を 1 つの Worker として配信します。
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "typescript-app-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // 静的ファイルの配信設定。
  // /api/* だけが Worker（Hono）に届き、それ以外は静的ファイルとして直接返されます。
  // 存在しないパスは index.html を返す（TanStack Router がブラウザ側で経路を解決するため）。
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // D1（SQLite 互換のデータベース）。
  // database_id は書かず、名前（database_name）で探して Worker に紐付けます。
  // その名前のデータベースがなければ、初回の `wrangler deploy` が自動で作成します。
  // ただし自動作成では配置場所を指定できないため、日本から使うなら事前に東アジア向けで作っておきます:
  //   npx wrangler d1 create typequest-apac --location apac
  // ローカル開発とテストでは、手元に作られる D1 が使われます。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typequest-apac",
      "migrations_dir": "migrations",
    },
  ],

  // レート制限（第 1 段）。Cloudflare の各拠点の中で数えるので速く、D1 を使いません。
  // 数はおおよそで、拠点ごとに別々です。正確な判定は第 2 段（D1 のカウンター）で行います。
  // 上限は第 2 段（src/config/config.ts の RATE_LIMITS）の 2 倍にして、攻撃だけをここで止めます。
  //   namespace_id: アカウントの中で重ならない整数（文字列で書く）
  //   period: 数える期間の秒数。10 か 60 のどちらかしか選べません
  // 詳しくは docs/specs/0004-edge-rate-limiting.md を参照してください。
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "PACKAGE_SEARCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],

  // 秘密ではない設定値。ローカル開発では .dev.vars の値で上書きされます。
  "vars": {
    // 状態を変更するリクエストを許可する追加のオリジン（カンマ区切り）。
    // 同一オリジンは常に許可されるので、本番では通常は空のままで構いません。
    "ALLOWED_ORIGINS": "",
  },

  "observability": { "enabled": true },
}
