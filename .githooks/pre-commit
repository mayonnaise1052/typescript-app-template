#!/bin/sh
# コミットの直前に実行されるスクリプト（Git フック）。
# 型エラーのあるコードはコミットさせません。
#
# 緊急時など、どうしても飛ばしたいときは `git commit --no-verify` を使います
# （その場合も、main へのプッシュ後に CI とデプロイ前のチェックで検出されます）。

echo "型チェックを実行しています…（npm run typecheck）"
if ! npm run typecheck --silent; then
  echo ""
  echo "✗ 型エラーがあるため、コミットを中止しました。上のエラーを修正してから、もう一度コミットしてください。"
  exit 1
fi
echo "✓ 型チェックに成功しました"
